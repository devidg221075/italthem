# ital-therm.it - generated by `npm run build` (template: server/.htaccess.tpl). Apache 2.4.
# Redirects below the marker are generated from the content (every old WordPress URL).

AddDefaultCharset utf-8
DirectoryIndex index.html
Options -Indexes -MultiViews
DirectorySlash Off

ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# Server-side code is only reachable through contact.php.
<FilesMatch "^(contact-lib\.php)$">
  Require all denied
</FilesMatch>

# PHP: never print errors to visitors (only active under mod_php; with PHP-FPM set display_errors in the pool/php.ini).
<IfModule mod_php.c>
  php_flag display_errors off
</IfModule>
<IfModule mod_php7.c>
  php_flag display_errors off
</IfModule>
<IfModule mod_php8.c>
  php_flag display_errors off
</IfModule>

<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# Order matters: old URLs and the directory-slash rule come FIRST and redirect to absolute https://ital-therm.it targets,
# so any scheme/host (http, www, behind a proxy) reaches the final URL in ONE hop. The canonical host rules below only
# catch what is left (already-new URLs requested over http or www).
# {{REDIRECTS}}

# Built directories (/en/products, /it/prodotti/it-cc ...) get their trailing slash here, with an absolute https target
# (instead of mod_dir's DirectorySlash, which builds the scheme from the proxy-facing request). Only fires when the
# directory has an index.html, and its target ends in "/" so it cannot loop.
RewriteCond %{DOCUMENT_ROOT}/$0/index.html -f
RewriteRule ^(en|it)(/[a-z0-9-]+)*$ https://ital-therm.it/$0/? [R=301,L]

# Canonical host: https://ital-therm.it (no www, always HTTPS). The query string is kept.
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://ital-therm.it%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://ital-therm.it%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # CSS/JS are linked with ?v=<content hash> by the build, so a year is safe. Fonts keep their name: one year, not immutable.
  # Optimized photos carry a content hash in their name (<base>-<w>.<hash8>.webp): immutable. Favicons, PNG icons and the SVG logo
  # keep their name: one week. Apache applies the LAST matching FilesMatch, so the hashed rule comes after the generic image rule.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|webp|avif|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "-[0-9]+\.[0-9a-f]{8}\.(webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/gif "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>
